# Django development settings
DEBUG=True
ENABLE_WHITENOISE=False
DJANGO_SECRET_KEY=gapmap-local-development-key-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL connection
# Sample database: database
# Sample username: username
# Sample password: password
# Host: 127.0.0.1
# Port: 5432
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/database
# Sentence Transformers RAG
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu
# Set False once to download the model; use True for an offline judging environment.
RAG_EMBEDDING_LOCAL_ONLY=True
RAG_ALLOW_EMBEDDING_FALLBACK=True